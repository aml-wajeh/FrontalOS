# =============================================================================
# FrontalOS Platform — Environment Variables
# =============================================================================
# Copy to .env before running docker compose (it's loaded from the project
# root automatically): `cp .env.example .env`
#
# MUST change for local dev: JWT_SECRET_KEY (see below). Everything else can
# stay at its default for a first `docker compose up --build`. See
# docs/RUNBOOK.md for the full walkthrough.

# --- Database (services/cortix-api) ------------------------------------------
# docker-compose.yml sets DATABASE_URL for the cortix-api container directly
# (pointed at the `postgres` service) — this line is only consulted when
# running cortix-api OUTSIDE Docker (see RUNBOOK.md "Run without Docker").
# If unset, database/session.py falls back to a local SQLite file, dev/demo
# use only.
DATABASE_URL=postgresql://frontalos:frontalos@localhost:5432/frontalos

# --- Cache (services/cortix-api) ---------------------------------------------
# Same note as above — docker-compose.yml overrides this for the container;
# only used when running cortix-api outside Docker.
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT (services/cortix-api) ----------------------------------------
# REQUIRED — must be changed even for local dev. If left blank, the app runs
# with an insecure default and GET /health reports jwt_secret_is_default:
# true so a misconfigured deployment is visible. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI model paths (services/cortix-api) ------------------------------------
# Optional. Leave blank to run every AI endpoint in "demo" mode (deterministic
# placeholder responses, safe with zero model files present). See
# services/cortix-api/docs/MODELS_README.md for how to switch to "live" mode
# by dropping real weight files into services/cortix-api/models/.
CORTIX_TABULAR_MODEL_PATH=
CORTIX_MRI_MODEL_PATH=
CORTIX_MRI_MODEL_PATH_FEMALE=

# --- Chat LLM integration (services/cortix-api) ------------------------------
# Optional. POST /api/v1/chat/query works fully templated without it.
CHAT_LLM_API_KEY=

# --- FrontalOS engagement engine (services/frontalos-engine) -----------------
# Real trained weights already ship in the image at
# services/frontalos-engine/models/frontal_x3d_model.pth (X3D-XS backbone,
# DAiSEE dataset). This only needs to change if you swap in a different
# checkpoint.
FRONTALOS_MODEL_PATH=./models/frontal_x3d_model.pth

# --- Frontend (apps/web) ------------------------------------------------------
# NEXT_PUBLIC_* values are baked into the browser bundle at BUILD time (see
# apps/web/Dockerfile's build stage) — changing them after `docker compose
# up --build` has already built the image requires a rebuild, not just a
# restart. Defaults below assume the whole stack runs on localhost.
NEXT_PUBLIC_CORTIX_API_URL=http://localhost:8000
# Base URL only, no trailing path — the client appends
# /ws/observe/{sessionId} itself (see lib/websocket/useObserverSocket.ts).
NEXT_PUBLIC_FRONTALOS_WS_URL=ws://localhost:8001
# Server-only mirror of the CORTIX API base URL, read by the BFF proxy route
# and middleware.ts. docker-compose.yml overrides this to the internal
# service address (http://cortix-api:8000) for the containerized web
# service automatically — only used verbatim when running apps/web outside
# Docker. Falls back to NEXT_PUBLIC_CORTIX_API_URL if unset.
CORTIX_API_URL=http://localhost:8000

# --- General ------------------------------------------------------------------
NODE_ENV=production
