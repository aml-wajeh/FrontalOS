# FrontalOS Engine — real-time WebSocket inference service (see
# services/frontalos-engine). Patient Portal connects to
# `${NEXT_PUBLIC_FRONTALOS_WS_URL}/ws/observe/{session_id}`.
NEXT_PUBLIC_FRONTALOS_WS_URL=ws://localhost:8001

# CORTIX API — REST service (see services/cortix-api). Patient Portal hits
# `${NEXT_PUBLIC_CORTIX_API_URL}/api/v1/...`.
NEXT_PUBLIC_CORTIX_API_URL=http://localhost:8000

# Server-only mirror of the same CORTIX API base URL, read by the Next.js
# Route Handlers under app/api/auth/* (lib/auth/session.ts). Kept separate
# from NEXT_PUBLIC_CORTIX_API_URL on purpose: route handlers run server-side
# only, so this never needs to (and should not) leak into client bundles.
# Falls back to NEXT_PUBLIC_CORTIX_API_URL if unset.
CORTIX_API_URL=http://localhost:8000

# Optional. If set, middleware.ts verifies the access-token cookie's HS256
# signature (via `jose`) using this secret before trusting its claims for
# routing decisions. This MUST match services/cortix-api's JWT_SECRET_KEY
# (core/config.py) for verification to succeed. If unset, middleware falls
# back to an unverified expiry/claim check only — real authorization still
# happens on every API call, since the CORTIX API independently verifies
# the same token's signature server-side. See lib/auth/session.ts header.
JWT_SECRET_KEY=
